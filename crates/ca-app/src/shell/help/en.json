  "guide": {
    "title": "FLUVI Traffic Simulator Guide",
    "blocks": [
      {
        "kind": "heading",
        "text": "Basic Controls"
      },
      {
        "kind": "item",
        "text": "Zoom: Mouse wheel"
      },
      {
        "kind": "item",
        "text": "Pan view: Drag with the mouse"
      },
      {
        "kind": "item",
        "text": "Add/remove vehicles: Click on cells"
      },
      {
        "kind": "item",
        "text": "Minimap: Click to teleport"
      },
      {
        "kind": "heading",
        "text": "Control Panel"
      },
      {
        "kind": "item",
        "text": "Quick selection: Ctrl+Click streets or buildings on the canvas"
      },
      {
        "kind": "item",
        "text": "Dropdown menu: Select objects manually"
      },
      {
        "kind": "item",
        "text": "Probabilities: Adjust generation and lane changes"
      },
      {
        "kind": "item",
        "text": "Apply changes: Blue button at the bottom"
      },
      {
        "kind": "heading",
        "text": "Edit Mode"
      },
      {
        "kind": "item",
        "text": "1. Select a street or building"
      },
      {
        "kind": "item",
        "text": "2. Enable \"Edit Mode\""
      },
      {
        "kind": "item",
        "text": "3. Drag the blue handle to move"
      },
      {
        "kind": "item",
        "text": "4. Drag the green handle to rotate"
      },
      {
        "kind": "item",
        "text": "5. Save or cancel the changes"
      },
      {
        "kind": "heading",
        "text": "Curved Streets"
      },
      {
        "kind": "item",
        "text": "1. Select a street"
      },
      {
        "kind": "item",
        "text": "2. Enable \"Edit Mode\""
      },
      {
        "kind": "item",
        "text": "3. Click \"Edit Vertices\""
      },
      {
        "kind": "item",
        "text": "4. Press Z to enable vertex editing"
      },
      {
        "kind": "item",
        "text": "5. Drag vertices to create curves"
      },
      {
        "kind": "item",
        "text": "6. Press Z again to disable"
      },
      {
        "kind": "item",
        "text": "7. Maximum angle: ±40° per cell"
      },
      {
        "kind": "item",
        "text": "8. Use \"Reset Vertices\" to restore"
      },
      {
        "kind": "heading",
        "text": "Simulation Control"
      },
      {
        "kind": "item",
        "text": "Pause/Resume: Stop/continue the simulation"
      },
      {
        "kind": "item",
        "text": "Step by Step: Advance frame by frame"
      },
      {
        "kind": "item",
        "text": "Speed: Adjust frames per second"
      },
      {
        "kind": "item",
        "text": "Generation: % of vehicle appearance"
      },
      {
        "kind": "heading",
        "text": "⏰ Virtual Time"
      },
      {
        "kind": "item",
        "text": "Change Date and Time: Set the weekday (Mon-Sun) and starting hour (0-23)"
      },
      {
        "kind": "item",
        "text": "Time advances automatically: 2 virtual seconds per simulation step"
      },
      {
        "kind": "item",
        "text": "Dynamic profiles: Traffic varies by day and hour"
      },
      {
        "kind": "heading",
        "text": "Generation Multipliers"
      },
      {
        "kind": "item",
        "text": "Per-day settings: Adjust multipliers for each day of the week"
      },
      {
        "kind": "item",
        "text": "Per-hour settings: 24 values (one for each hour of the day)"
      },
      {
        "kind": "item",
        "text": "Range: 0.0 (no traffic) to 3.0 (very heavy traffic)"
      },
      {
        "kind": "item",
        "text": "Presets: Weekday, Weekend, Constant, Night"
      },
      {
        "kind": "item",
        "text": "Each hour is independent: 08:00 controls from 08:00 to 08:59"
      },
      {
        "kind": "heading",
        "text": "Connections"
      },
      {
        "kind": "paragraph",
        "text": "Types of connections between streets:"
      },
      {
        "kind": "item",
        "text": "Green (Linear): 1 to 1 between lanes"
      },
      {
        "kind": "item",
        "text": "Orange (Incorporation): Several to one"
      },
      {
        "kind": "item",
        "text": "Purple (Probabilistic): With probability"
      },
      {
        "kind": "item",
        "text": "Red: Blocked connection"
      },
      {
        "kind": "heading",
        "text": "Map Constructor"
      },
      {
        "kind": "item",
        "text": "Ctrl+Click: Select streets and buildings directly on the canvas"
      },
      {
        "kind": "item",
        "text": "Add objects: Use the buttons to create streets and buildings"
      },
      {
        "kind": "item",
        "text": "Edit mode: Drag and rotate objects visually"
      },
      {
        "kind": "item",
        "text": "Connections: Connect streets to create traffic flow"
      },
      {
        "kind": "item",
        "text": "Reference image: Load a local image or link a URL; you can replace or remove it. Local images are embedded in the JSON; linked images store the URL and depend on the source remaining available."
      },
      {
        "kind": "item",
        "text": "Save/Load: Export and import simulations as JSON"
      },
      {
        "kind": "heading",
        "text": "Parking"
      },
      {
        "kind": "item",
        "text": "Configuration: Mark a building as parking"
      },
      {
        "kind": "item",
        "text": "Capacity: Set the maximum number of vehicles"
      },
      {
        "kind": "item",
        "text": "Connections: Entry/exit pairs on streets"
      },
      {
        "kind": "item",
        "text": "Probabilities: Adjust entry/exit per hour (0-100%)"
      },
      {
        "kind": "item",
        "text": "Profiles: Normal, Office, Shopping Center"
      },
      {
        "kind": "item",
        "text": "Validation: Prevents invalid configurations"
      },
      {
        "kind": "heading",
        "text": "Scenario Management"
      },
      {
        "kind": "item",
        "text": "Save: Export the complete configuration as JSON"
      },
      {
        "kind": "item",
        "text": "Load: Import previously saved scenarios"
      },
      {
        "kind": "item",
        "text": "Includes: Streets, buildings, parking"
      },
      {
        "kind": "item",
        "text": "Connections: Keeps all street connections"
      },
      {
        "kind": "item",
        "text": "Probabilities: Preserves hourly settings"
      },
      {
        "kind": "heading",
        "text": "Simulator Metrics"
      },
      {
        "kind": "heading",
        "text": "Main Metrics"
      },
      {
        "kind": "item",
        "text": "Density: % of street occupancy (0-100%)"
      },
      {
        "kind": "item",
        "text": "Vehicular Flow: Vehicles/second according to Q=k×v"
      },
      {
        "kind": "item",
        "text": "Rate of Change: Net population growth (veh/s)"
      },
      {
        "kind": "item",
        "text": "Average Speed: % of vehicles in motion"
      },
      {
        "kind": "item",
        "text": "Shannon Entropy: Diversity of the CA's 8 transitions (bits)"
      },
      {
        "kind": "heading",
        "text": "Smart Interpretation"
      },
      {
        "kind": "item",
        "text": "Optimal: Maximum system efficiency"
      },
      {
        "kind": "item",
        "text": "Moderate: Acceptable conditions"
      },
      {
        "kind": "item",
        "text": "Congested: High density with slow movement"
      },
      {
        "kind": "item",
        "text": "Collapse: Streets at a standstill"
      },
      {
        "kind": "item",
        "text": "Underused: Low occupancy"
      },
      {
        "kind": "heading",
        "text": "Available Tools"
      },
      {
        "kind": "item",
        "text": "5 Real-Time Charts: View all metrics with Chart.js"
      },
      {
        "kind": "item",
        "text": "Status Panel: Automatic traffic interpretation with recommendations"
      },
      {
        "kind": "item",
        "text": "Export CSV: Download the full history with statistics"
      },
      {
        "kind": "item",
        "text": "Export JSON: Structured format with metadata"
      },
      {
        "kind": "item",
        "text": "Clear Metrics: Reset the measurement history"
      },
      {
        "kind": "item",
        "text": "Heatmap: View density by geographic area"
      },
      {
        "kind": "paragraph",
        "text": "Tips: Metrics update every 5 frames to optimize performance. The chart history shows the last 50 points, but the CSV exports ALL measurements since the start."
      },
      {
