      {
        "kind": "item",
        "text": "• Boxplots comparativos"
      },
      {
        "kind": "item",
        "text": "• Estadísticas descriptivas"
      },
      {
        "kind": "heading",
        "text": "Cómo Usar"
      },
      {
        "kind": "item",
        "text": "Ejecuta una simulación en FLUVI"
      },
      {
        "kind": "item",
        "text": "Exporta métricas: \"Descargar CSV\""
      },
      {
        "kind": "item",
        "text": "Clic en \"Analizar Métricas\""
      },
      {
        "kind": "item",
        "text": "Carga el archivo CSV exportado"
      },
      {
        "kind": "item",
        "text": "Espera el procesamiento (~30-60 seg)"
      },
      {
        "kind": "item",
        "text": "Navega entre las 3 pestañas"
      },
      {
        "kind": "item",
        "text": "Descarga gráficas (individual o ZIP)"
      },
      {
        "kind": "heading",
        "text": "Métricas Calculadas"
      },
      {
        "kind": "item",
        "text": "• Clasificación de estados del sistema"
      },
      {
        "kind": "item",
        "text": "• Estadísticas por día de la semana"
      },
      {
        "kind": "item",
        "text": "• Capacidad crítica del sistema"
      },
      {
        "kind": "item",
        "text": "• Correlaciones entre variables"
      },
      {
        "kind": "item",
        "text": "• Detección de eventos anómalos"
      },
      {
        "kind": "item",
        "text": "• Análisis temporal con tendencias"
      },
      {
        "kind": "heading",
        "text": "Mapa de Calor"
      },
      {
        "kind": "paragraph",
        "text": "Visualización que organiza la densidad promedio en una matriz de: Días de la semana (filas) Horas del día 0-23 (columnas)"
      },
      {
        "kind": "paragraph",
        "text": "Amarillo → Baja densidad de vehículos Rojo → Alta densidad de vehículos"
      },
      {
        "kind": "item",
        "text": "• Horas pico: Columnas rojas intensas"
