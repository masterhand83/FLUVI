{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules/**",
      "!!**/.alchemy/**",
      "!!**/.turbo/**",
      "!!**/coverage/**",
      "!!**/dist/**",
      "!!**/build/**",
      "!!apps/v1/src/bootstrap-5.0.2-dist/**",
      "!!apps/v1/src/libs/chart.js/**"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
